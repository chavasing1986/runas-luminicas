import type{NameDNA}from"../engine/nameDNA";import type{RuneModel}from"../engine/types";
export default function AnalysisPanel({dna,model}:{dna:NameDNA;model:RuneModel}){const rep=Object.entries(dna.repetitions).filter(([,c])=>c>1);const items:[string,string|number][]=[["Código",dna.code],["Letras",dna.length],["Suma",dna.sum],["Frecuencia",dna.digitalRoot],["Vocales",dna.vowels],["Consonantes",dna.consonants],["Ejes",dna.axes],["Repeticiones",rep.length]];return <aside className="panel analysis-panel"><div className="kicker">SIGNIFICADO</div><h2>{model.title}</h2><p className="reading">Esta runa traduce la arquitectura nominal de <strong>{dna.normalized}</strong> en un único glifo vertical.</p><div className="section"><div className="section-title">ESENCIA</div><p className="reading">{model.descriptors.join(" · ")}</p></div><div className="section"><div className="section-title">ADN GEOMÉTRICO</div><div className="metrics">{items.map(([l,v])=><div className="metric" key={l}><small>{l}</small><strong>{v}</strong></div>)}</div></div><div className="mantra">«LA FIRMA NO SE ESCRIBE. LA IDENTIDAD SE CONSTRUYE.»</div></aside>}
